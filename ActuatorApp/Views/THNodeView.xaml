<UserControl x:Class="ActuatorApp.Views.THNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
             xmlns:local="clr-namespace:ActuatorApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="150">
    <views:NodeView x:Name="NodeView">
        <!-- 使用 TrailingControlPresenterStyle 在輸入輸出埠之後添加自訂內容 -->
        <views:NodeView.TrailingControlPresenterStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Margin="10,5,10,5">
                                <TextBlock Text="通訊協定 (Protocol)" 
                                           Foreground="White" 
                                           FontSize="10" 
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                
                                <!-- GPIO -->
                                <RadioButton x:Name="GpioRadio" 
                                             Content="GPIO" 
                                             GroupName="Protocol"
                                             Foreground="White"
                                             FontSize="11"
                                             Margin="2"/>
                                
                                <!-- Scan -->
                                <RadioButton x:Name="ScanRadio" 
                                             Content="Scan" 
                                             GroupName="Protocol"
                                             Foreground="White"
                                             FontSize="11"
                                             Margin="2"/>
                                
                                <!-- TBUS -->
                                <RadioButton x:Name="TbusRadio" 
                                             Content="TBUS" 
                                             GroupName="Protocol"
                                             Foreground="White"
                                             FontSize="11"
                                             Margin="2"/>
                                
                                <!-- Get ID 按鈕 -->
                                <Button x:Name="GetIdButton" 
                                        Content="Get ID" 
                                        Background="#00897B"
                                        Foreground="White"
                                        FontSize="11"
                                        Padding="10,5"
                                        Margin="0,8,0,0"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </views:NodeView.TrailingControlPresenterStyle>
    </views:NodeView>
</UserControl>
