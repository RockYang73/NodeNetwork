<Window x:Class="ActuatorApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
        xmlns:local="clr-namespace:ActuatorApp.Views"
        xmlns:vm="clr-namespace:ActuatorApp.ViewModels"
        xmlns:nodes="clr-namespace:ActuatorApp.ViewModels.Nodes"
        xmlns:converters="clr-namespace:ActuatorApp.Views.Converters"
        mc:Ignorable="d"
        Title="ActuatorApp - 電動推桿控制系統節點編輯器"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 節點項目模板 (Updated for Horizontal Layout with Image) -->
        <DataTemplate x:Key="NodeItemTemplate" DataType="{x:Type vm:NodeItemViewModel}">
            <Border Background="Transparent" Margin="8,5" Cursor="Hand" ToolTip="{Binding Name}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <!-- Image (Height set to 70 to be visible) -->
                    <Image Source="{Binding ImagePath}" Height="70" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="80"/>
                </StackPanel>
            </Border>
                </DataTemplate>

                <converters:TypeVisibilityCheck x:Key="TypeCheckToVisibility"/>

                <ContextMenu x:Key="nodeMenu" x:Shared="True">
            <!-- 隱藏原有的 GroupNode 功能 -->
            <MenuItem Header="群組選取節點"
                      Command="{Binding DataContext.GroupNodesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="Collapsed"/>
            <MenuItem Header="群組選取節點 (容器樣式)"
                      Command="{Binding DataContext.GroupNodesAsContainerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      ToolTip="使用新的 Header Container 樣式建立群組"
                      Visibility="Collapsed"/>
            <!-- FrameNode 視覺分組 -->
            <MenuItem Header="建立 Frame (視覺分組)"
                      Command="{Binding DataContext.CreateFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      ToolTip="建立類似 Blender 的視覺分組容器"/>
            <Separator/>
            <MenuItem Header="解散群組"
                      Command="{Binding DataContext.UngroupNodesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="{Binding Converter={StaticResource TypeCheckToVisibility}, ConverterParameter={x:Type nodes:GroupNodeViewModel}}"/>
            <MenuItem Header="進入群組"
                      Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="{Binding Converter={StaticResource TypeCheckToVisibility}, ConverterParameter={x:Type nodes:GroupNodeViewModel}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Product Tabs (New) -->
            <RowDefinition Height="*"/>    <!-- Network Canvas -->
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Grid Grid.Row="0" Background="White" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Connection & Program -->
                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- File Buttons & Tools -->
            </Grid.ColumnDefinitions>

            <!-- Left Side: Connection & Program -->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <!-- Connection Check Group -->
                <GroupBox Header="Connection check" Margin="5,2" BorderBrush="#E0E0E0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="COM port" VerticalAlignment="Center" Margin="5,0"/>
                        <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" Width="80" Margin="5"/>
                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" Width="80" Margin="5"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionStatusColor}" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Program Group -->
                <GroupBox Header="Program" Margin="5,2" BorderBrush="#E0E0E0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Program" Command="{Binding ProgramCommand}" Width="80" Margin="5"/>
                        <Button Content="Read from MCU" Command="{Binding ReadFromMcuCommand}" Width="100" Margin="5"/>
                        <ProgressBar Value="{Binding ProgressValue}" Width="150" Height="15" Margin="5" Foreground="#00C853" Background="#E0E0E0" BorderThickness="0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Right Side: File Operations & Tools -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5">
                <!-- Tools moved from sidebar -->
                <Button x:Name="AddParameterButton" Content="Add Parameter" Padding="8,4" Margin="2" Background="#FAFAFA"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>

                <!-- File Ops -->
                <Button Content="Load File" Command="{Binding LoadFileCommand}" Padding="10,5" Margin="2" Background="White" BorderBrush="#E0E0E0"/>
                <Button Content="Save File" Command="{Binding SaveFileCommand}" Padding="10,5" Margin="2" Background="White" BorderBrush="#E0E0E0"/>
                <Button Content="Generate SOI" Command="{Binding GenerateSoiCommand}" Padding="10,5" Margin="2" Background="White" BorderBrush="#E0E0E0"/>
                <Button Content="Generate HEX File" Command="{Binding GenerateHexCommand}" Padding="10,5" Margin="2" Background="White" BorderBrush="#E0E0E0"/>
            </StackPanel>
        </Grid>

        <!-- Horizontal Product Tabs -->
        <TabControl x:Name="NodeCategoryTabs"
                    Grid.Row="1"
                    Margin="0"
                    Padding="0"
                    BorderThickness="0,1,0,1"
                    BorderBrush="#E0E0E0"
                    Background="White"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Control Box -->
            <TabItem Header="Control box">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl x:Name="ControlBoxNodes" ItemTemplate="{StaticResource NodeItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Actuator -->
            <TabItem Header="Actuator">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl x:Name="ActuatorNodes" ItemTemplate="{StaticResource NodeItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Controls (Grouped) -->
            <TabItem Header="Controls">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Embedded -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ItemsControl x:Name="EmbeddedNodes" ItemTemplate="{StaticResource NodeItemTemplate}" Grid.Row="0" Margin="5,5,5,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Grid.Row="1" Background="#546E7A" Padding="5,2">
                                    <TextBlock Text="Embedded" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Wire Handset -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ItemsControl x:Name="WireHandsetNodes" ItemTemplate="{StaticResource NodeItemTemplate}" Grid.Row="0" Margin="5,5,5,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Grid.Row="1" Background="#546E7A" Padding="5,2">
                                    <TextBlock Text="Wire Handset" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Wireless Handset -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ItemsControl x:Name="WirelessHandsetNodes" ItemTemplate="{StaticResource NodeItemTemplate}" Grid.Row="0" Margin="5,5,5,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Grid.Row="1" Background="#546E7A" Padding="5,2">
                                    <TextBlock Text="Wireless Handset" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Handheld -->
                         <Border>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ItemsControl x:Name="HandheldNodes" ItemTemplate="{StaticResource NodeItemTemplate}" Grid.Row="0" Margin="5,5,5,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Grid.Row="1" Background="#546E7A" Padding="5,2">
                                    <TextBlock Text="Handheld" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Accessories -->
            <TabItem Header="Accessories">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl x:Name="AccessoryNodes" ItemTemplate="{StaticResource NodeItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Power Supply -->
            <TabItem Header="Power supply">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl x:Name="PowerSupplyNodes" ItemTemplate="{StaticResource NodeItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Battery -->
            <TabItem Header="Battery">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl x:Name="BatteryNodes" ItemTemplate="{StaticResource NodeItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Network Canvas with Frames Layer -->
        <Grid Grid.Row="2">
            <!-- Frames 視覺分組層 (渲染在節點下方) -->
            <ItemsControl x:Name="FramesControl"
                          Background="Transparent"
                          IsHitTestVisible="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas x:Name="FramesCanvas"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type nodes:FrameNodeViewModel}">
                        <local:FrameNodeView ViewModel="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Network View (節點和連線) -->
            <views:NetworkView x:Name="NetworkView"
                               Background="Transparent">
                <views:NetworkView.Resources>
                    <Style TargetType="views:NodeView">
                        <Setter Property="ContextMenu" Value="{StaticResource nodeMenu}" />
                    </Style>
                </views:NetworkView.Resources>
                <views:NetworkView.NetworkBackground>
                    <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,50,50"
                                  ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#E0E0E0" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </views:NetworkView.NetworkBackground>
            </views:NetworkView>
        </Grid>
    </Grid>
</Window>